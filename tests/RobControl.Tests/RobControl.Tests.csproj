<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain net10.0 while the app has no view-model tests: the engine and the simulator are all
       this needs, and it keeps the suite runnable anywhere the SDK is. When view models arrive,
       this moves to net10.0-windows exactly as NetControl.Tests did. -->

  <PropertyGroup>
    <RootNamespace>RobControl.Tests</RootNamespace>
    <AssemblyName>RobControl.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RobControl.Core\RobControl.Core.csproj" />
    <ProjectReference Include="..\..\src\RobControl.RobotSim\RobControl.RobotSim.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copied byte for byte beside the test assembly, so a profile is found by a path relative to it. -->
    <None Include="..\Fixtures\**\*" LinkBase="Fixtures" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
