<Window x:Class="RobControl.App.Views.SignalBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RobControl.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SignalBrowserViewModel}"
        Title="Browse signals"
        Width="860" Height="640"
        MinWidth="620" MinHeight="400"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource ChromeDialog}">

  <DockPanel Margin="18,12,18,14">

    <!-- What is listed, and from where. -->
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Style="{StaticResource PanelTitle}" Text="{Binding Heading}" />
      <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" Text="{Binding Source}" />
      <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,10"
                 Text="Tick what to watch and press Add: it goes on the Trends tab of every selected robot. Listing reads the backup on disk; Read from robot asks the robot for its register and I/O pages. Nothing is ever written to the robot." />

      <DockPanel Margin="0,0,0,8">
        <Button DockPanel.Dock="Right" Content="Read from robot" Margin="10,0,0,0"
                Command="{Binding ReadFromRobotCommand}"
                ToolTip="{Binding ReadFromRobotHint}" ToolTipService.ShowOnDisabled="True" />
        <ComboBox DockPanel.Dock="Right" Width="150" Margin="10,0,0,0"
                  ItemsSource="{x:Static vm:SignalBrowserViewModel.Categories}" SelectedItem="{Binding Category}" />
        <TextBlock DockPanel.Dock="Left" Text="Filter" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBox x:Name="FilterBox" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Part of a name, a comment or a kind: weld, DO[, $MCR, group out." />
      </DockPanel>

      <TextBlock Style="{StaticResource MutedWarning}" TextWrapping="Wrap" Margin="0,0,0,8" Text="{Binding Notes}"
                 Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisible}}" />
    </StackPanel>

    <!-- Counts and the buttons. -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Tick all shown" Command="{Binding TickShownCommand}" />
        <Button Content="Clear ticks" Command="{Binding ClearTicksCommand}" Margin="8,0,0,0" />
        <Button Content="{Binding AddText}" Style="{StaticResource PrimaryButton}" IsDefault="True"
                IsEnabled="{Binding CanAdd}" Click="OnAdd" MinWidth="80" Margin="16,0,0,0" />
        <Button Content="Cancel" IsCancel="True" MinWidth="80" Margin="8,0,0,0" />
      </StackPanel>
      <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Text="{Binding Counts}" TextTrimming="CharacterEllipsis" />
    </DockPanel>

    <Border Style="{StaticResource Card}" Padding="0">
      <DataGrid ItemsSource="{Binding Shown}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                SelectionMode="Extended"
                HeadersVisibility="Column"
                GridLinesVisibility="Horizontal"
                RowHeaderWidth="0"
                BorderThickness="0"
                EnableRowVirtualization="True"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                PreviewKeyDown="OnGridKeyDown"
                MouseDoubleClick="OnGridDoubleClick">
        <DataGrid.Columns>
          <!-- A template column, not DataGridCheckBoxColumn: that one needs a click to enter edit
               mode and a second to tick, which reads as a broken checkbox. -->
          <DataGridTemplateColumn Header="" Width="30">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate DataType="{x:Type vm:SignalBrowserRowViewModel}">
                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                          IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Signal" Width="190" IsReadOnly="True" Binding="{Binding Signal, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
          <DataGridTextColumn Header="Kind" Width="110" IsReadOnly="True" Binding="{Binding Kind, Mode=OneWay}" />
          <DataGridTextColumn Header="Comment" Width="*" IsReadOnly="True" Binding="{Binding Comment, Mode=OneWay}" />
          <DataGridTextColumn Header="Value" Width="110" IsReadOnly="True" Binding="{Binding Value, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
          <DataGridTemplateColumn Header="Watched" Width="70" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate DataType="{x:Type vm:SignalBrowserRowViewModel}">
                <TextBlock Style="{StaticResource Muted}" Text="on Trends" VerticalAlignment="Center"
                           ToolTip="Already on the Trends tab for this robot."
                           Visibility="{Binding AlreadyWatched, Converter={StaticResource BoolToVisible}}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</Window>
