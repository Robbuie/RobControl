<Window x:Class="RobControl.App.Views.RobotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Robot"
        SizeToContent="Height"
        Width="440"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource ChromeDialog}">

  <Grid Margin="18,16,18,14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="110" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Name" VerticalAlignment="Center" />
    <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Margin="0,3"
             ToolTip="What the plant calls it. Also its folder in the archive, so it has to be unique." />

    <TextBlock Grid.Row="1" Text="Address" VerticalAlignment="Center" />
    <TextBox Grid.Row="1" Grid.Column="1" x:Name="AddressBox" Margin="0,3" FontFamily="{DynamicResource mono}"
             ToolTip="The controller's own IPv4 address, e.g. 10.20.1.54." />

    <TextBlock Grid.Row="2" Text="Line / cell" VerticalAlignment="Center" />
    <TextBox Grid.Row="2" Grid.Column="1" x:Name="LineBox" Margin="0,3" />

    <TextBlock Grid.Row="3" Text="Notes" VerticalAlignment="Center" />
    <TextBox Grid.Row="3" Grid.Column="1" x:Name="NotesBox" Margin="0,3" />

    <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Style="{StaticResource PanelHead}" Text="FTP LOGIN" Margin="0,12,0,2" />
    <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"
               Text="A controller with no FTP users set up accepts 'anonymous' with no password. Change these only if Setup > Host Comm > FTP on the pendant says otherwise." />

    <TextBlock Grid.Row="6" Text="User" VerticalAlignment="Center" />
    <TextBox Grid.Row="6" Grid.Column="1" x:Name="UserBox" Margin="0,3" />

    <TextBlock Grid.Row="7" Text="Password" VerticalAlignment="Center" />
    <PasswordBox Grid.Row="7" Grid.Column="1" x:Name="PasswordInput" Margin="0,3"
                 ToolTip="Stored in the fleet database in your profile. It is never written to a transcript or the event log." />

    <TextBlock Grid.Row="8" Text="Ports" VerticalAlignment="Center" />
    <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
      <TextBlock Text="FTP" VerticalAlignment="Center" Margin="0,0,6,0" />
      <TextBox x:Name="FtpPortBox" Width="60" FontFamily="{DynamicResource mono}" />
      <TextBlock Text="Web" VerticalAlignment="Center" Margin="14,0,6,0" />
      <TextBox x:Name="HttpPortBox" Width="60" FontFamily="{DynamicResource mono}" />
    </StackPanel>

    <TextBlock Grid.Row="9" Grid.ColumnSpan="2" x:Name="ProblemText" Style="{StaticResource FaultText}"
               TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />

    <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="OK" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk" MinWidth="80" />
      <Button Content="Cancel" IsCancel="True" MinWidth="80" Margin="8,0,0,0" />
    </StackPanel>
  </Grid>
</Window>
