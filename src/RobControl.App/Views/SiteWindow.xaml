<Window x:Class="RobControl.App.Views.SiteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Site"
        SizeToContent="Height"
        Width="540"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource ChromeDialog}">

  <Grid Margin="18,16,18,14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="120" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Name" VerticalAlignment="Center" />
    <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Margin="0,3"
             ToolTip="The plant, or the plant and the shop. Shown in the title bar so nobody backs up the wrong one." />

    <TextBlock Grid.Row="1" Text="Archive folder" VerticalAlignment="Center" />
    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,3">
      <Button DockPanel.Dock="Right" Content="Browse..." Click="OnBrowse" Margin="6,0,0,0" />
      <TextBox x:Name="ArchiveBox" FontFamily="{DynamicResource mono}"
               ToolTip="Where this site's backups go. Leave blank for a folder named after the site under Documents\RobControl Backups." />
    </DockPanel>
    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"
               Text="Changing it does not move backups already taken; the history reads the new folder from then on." />

    <TextBlock Grid.Row="3" Text="Robots at once" VerticalAlignment="Center" />
    <TextBox Grid.Row="3" Grid.Column="1" x:Name="ConcurrencyBox" Width="60" HorizontalAlignment="Left" Margin="0,3"
             FontFamily="{DynamicResource mono}"
             ToolTip="How many robots are backed up or probed at the same time. Never more than one session per robot whatever this says." />

    <TextBlock Grid.Row="4" Text="Stale after" VerticalAlignment="Center" />
    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
      <TextBox x:Name="StaleBox" Width="60" FontFamily="{DynamicResource mono}"
               ToolTip="A robot whose last complete backup is older than this is flagged stale in the Fleet tab and the site report." />
      <TextBlock Text="days" VerticalAlignment="Center" Margin="6,0,0,0" />
    </StackPanel>

    <TextBlock Grid.Row="5" Text="Retries" VerticalAlignment="Center" />
    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
      <TextBox x:Name="RetriesBox" Width="60" FontFamily="{DynamicResource mono}"
               ToolTip="How many times a scheduled backup tries again, a few minutes later, a robot that failed or came back partial. 0 is off. Backups started by hand are not retried." />
      <TextBlock Text="for scheduled backups that do not complete" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0" />
    </StackPanel>

    <TextBlock Grid.Row="6" Text="Keep" VerticalAlignment="Center" />
    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
      <TextBox x:Name="KeepBox" Width="60" FontFamily="{DynamicResource mono}"
               ToolTip="Complete backups per robot that Fleet > Prune old backups keeps. 0 turns pruning off. Nothing is ever pruned automatically - it asks first, and sends to the Recycle Bin." />
      <TextBlock Text="complete backups per robot when pruning (0 = off)" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0" />
    </StackPanel>

    <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Style="{StaticResource PanelHead}" Text="FTP LOGIN FOR NEW ROBOTS" Margin="0,12,0,2" />
    <TextBlock Grid.Row="8" Grid.ColumnSpan="2" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"
               Text="What Add robot fills in at this site. Robots already in the list keep their own login." />

    <TextBlock Grid.Row="9" Text="User" VerticalAlignment="Center" />
    <TextBox Grid.Row="9" Grid.Column="1" x:Name="UserBox" Margin="0,3" />

    <TextBlock Grid.Row="10" Text="Password" VerticalAlignment="Center" />
    <PasswordBox Grid.Row="10" Grid.Column="1" x:Name="PasswordInput" Margin="0,3"
                 ToolTip="Stored in this site's site.json, and in a site export. Never written to a transcript or the event log." />

    <TextBlock Grid.Row="11" Text="Notes" VerticalAlignment="Top" Margin="0,6,0,0" />
    <TextBox Grid.Row="11" Grid.Column="1" x:Name="NotesBox" Margin="0,3" Height="64"
             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
             ToolTip="Who to call, which VLAN, where the laptop plugs in - whatever is worth knowing next visit." />

    <TextBlock Grid.Row="12" Grid.ColumnSpan="2" x:Name="ProblemText" Style="{StaticResource FaultText}"
               TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />

    <StackPanel Grid.Row="13" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="OkButton" Content="OK" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk" MinWidth="80" />
      <Button Content="Cancel" IsCancel="True" MinWidth="80" Margin="8,0,0,0" />
    </StackPanel>
  </Grid>
</Window>
