<Window x:Class="RobControl.App.Views.DocumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Read me"
        Height="760" Width="860"
        MinHeight="360" MinWidth="520"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource ChromeWindow}">

  <!-- Help > Read me and Help > What's new: the README or the changelog compiled into this build. -->
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource bg-1}" BorderBrush="{DynamicResource line}"
            BorderThickness="0,1,0,0" Padding="12,8">
      <DockPanel>
        <TextBlock x:Name="SourceText" Style="{StaticResource Muted}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Open on GitHub" Click="OnOpenOnline" Margin="0,0,8,0"
                  ToolTip="The newest version of this page, which may describe a newer release than the one running." />
          <Button Content="Close" IsCancel="True" IsDefault="True" Click="OnClose" MinWidth="80" />
        </StackPanel>
      </DockPanel>
    </Border>

    <FlowDocumentScrollViewer x:Name="Viewer" IsToolBarVisible="False" Background="{DynamicResource bg-1}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
  </DockPanel>
</Window>
