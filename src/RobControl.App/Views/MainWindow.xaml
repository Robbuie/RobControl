<Window x:Class="RobControl.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RobControl.App.ViewModels"
        xmlns:views="clr-namespace:RobControl.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        Height="760" Width="1260"
        MinHeight="520" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ChromeWindow}">

  <DockPanel>

    <!-- ============================== Status bar ============================== -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource bg-1}"
            BorderBrush="{DynamicResource line}"
            BorderThickness="0,1,0,0"
            Padding="10,5">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Style="{StaticResource Muted}" Text="{Binding Status}"
                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <TextBlock Text="{Binding SiteName}" FontWeight="SemiBold" ToolTip="The open site. System > Open system to switch." />
          <TextBlock Style="{StaticResource Muted}" Text=" / " />
          <TextBlock Text="{Binding SystemName}" FontWeight="SemiBold" ToolTip="{Binding BackupDefaultsText}" />
          <TextBlock Style="{StaticResource Muted}" Text="  -  " />
          <TextBlock Style="{StaticResource Muted}" Text="{Binding ScheduleText}" />
          <TextBlock Style="{StaticResource Muted}" Text="  -  " />
          <TextBlock Style="{StaticResource Muted}" Text="{Binding ArchiveRoot}" ToolTip="Archive folder" />
          <TextBlock Style="{StaticResource Muted}" Text="  -  " />
          <TextBlock Style="{StaticResource Muted}" Text="{Binding Version}" />
          <TextBlock Margin="10,0,0,0" Foreground="{DynamicResource accent-text}" Cursor="Hand"
                     Text="{Binding UpdateStatus}"
                     Visibility="{Binding UpdateStatus, Converter={StaticResource NotNullToVisible}}"
                     MouseLeftButtonUp="OnUpdateStatusClicked" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================== Menu bar ============================== -->
    <!-- An ordinary child of the window, on a row of its own under the title bar. Through 0.5.0 it
         was a resource put into the title bar through Chrome.TitleContent and a TemplatedParent
         binding in ChromeWindow, and it never rendered there (0.5.0 screenshot: an empty gap
         between the mark and the title). Keep it in the tree, not in Resources. -->
    <Menu DockPanel.Dock="Top" Padding="6,2">
      <MenuItem Header="_Site">
        <!-- One line per site on this PC; each carries its own command (SiteChoiceViewModel). -->
        <MenuItem Header="_Switch to" ItemsSource="{Binding SiteChoices}">
          <MenuItem.ItemContainerStyle>
            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
              <Setter Property="Header" Value="{Binding Name}" />
              <Setter Property="IsChecked" Value="{Binding IsCurrent, Mode=OneWay}" />
              <Setter Property="Command" Value="{Binding Command}" />
            </Style>
          </MenuItem.ItemContainerStyle>
        </MenuItem>
        <Separator />
        <MenuItem Header="_New site..." Command="{Binding NewSiteCommand}"
                  ToolTip="A plant of its own: its own robot list, archive folder, schedule and event log." />
        <MenuItem Header="Site s_ettings..." Command="{Binding EditSiteCommand}"
                  ToolTip="Name, archive folder, robots at once, the FTP login new robots start with, notes." />
        <Separator />
        <MenuItem Header="_Import site file or bundle..." Command="{Binding ImportSiteCommand}"
                  ToolTip="Makes a new site from a file exported on another PC - a site file (settings and robot list) or a site bundle (that, plus event log, trends and backups). Never merges into a site you have." />
        <MenuItem Header="E_xport site file..." Command="{Binding ExportSiteCommand}"
                  ToolTip="This site's settings and robot list in one small file, to carry to another PC. It includes FTP passwords." />
        <MenuItem Header="Export site _bundle..." Command="{Binding ExportBundleCommand}"
                  ToolTip="The whole site in one zip: settings, robot list, event log, trends and - if you say so - every backup. For moving a site to another laptop, or out of a plant with no network. It includes FTP passwords." />
        <Separator />
        <MenuItem Header="Site _report..." Command="{Binding Fleet.ReportCommand}"
                  ToolTip="One page for the visit, from the backups: backup status, alarms needing a job, frequent alarms, watched setting changes, notes." />
        <MenuItem Header="Open backups from a fo_lder..." Command="{Binding OpenLooseCommand}"
                  ToolTip="A stick, a share, another engineer's archive: browse, compare, search and read alarm history from the files - no site needed, nothing written." />
        <Separator />
        <MenuItem Header="_Open site folder" Command="{Binding OpenSiteFolderCommand}"
                  ToolTip="Where site.json and the site's system folders live (Documents\RobControl\Systems). They can be edited by hand while the site is closed." />
      </MenuItem>
      <MenuItem Header="S_ystem">
        <MenuItem Header="_Open system..." Command="{Binding ChooseSystemCommand}"
                  ToolTip="Pick another system of this site or another site - or make a new one." />
        <!-- One line per system of the open site; each carries its own command. -->
        <MenuItem Header="_Switch to" ItemsSource="{Binding SystemChoices}">
          <MenuItem.ItemContainerStyle>
            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
              <Setter Property="Header" Value="{Binding Name}" />
              <Setter Property="IsChecked" Value="{Binding IsCurrent, Mode=OneWay}" />
              <Setter Property="Command" Value="{Binding Command}" />
            </Style>
          </MenuItem.ItemContainerStyle>
        </MenuItem>
        <Separator />
        <MenuItem Header="Site _visit..." Command="{Binding SiteVisitCommand}"
                  ToolTip="Every robot of this system in turn: probe, back up, capture for support - then one report and one zip to take home. Read-only." />
        <Separator />
        <MenuItem Header="System s_ettings..." Command="{Binding EditSystemCommand}"
                  ToolTip="Name, notes, and what a backup of this system takes: devices, folders, files to leave out." />
        <MenuItem Header="Open system _folder" Command="{Binding OpenSystemFolderCommand}"
                  ToolTip="Where this system's system.json lives. It can be edited by hand while the system is closed; robots typed into it by address are added when it is opened." />
      </MenuItem>
      <MenuItem Header="_Robots">
        <MenuItem Header="_Add robot..." Command="{Binding AddRobotCommand}" />
        <MenuItem Header="_Edit robot..." Command="{Binding EditRobotCommand}" />
        <MenuItem Header="_Remove robot" Command="{Binding RemoveRobotCommand}"
                  ToolTip="Takes it off the list. Its backups and its event log rows stay." />
        <!-- One line per system of the open site: moves the selected robots there. -->
        <MenuItem Header="_Move to system" ItemsSource="{Binding MoveChoices}"
                  ToolTip="Moves the selected robots - and their own backup settings - into another system of this site. Their backups and history stay where they are.">
          <MenuItem.ItemContainerStyle>
            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
              <Setter Property="Header" Value="{Binding Name}" />
              <Setter Property="IsChecked" Value="{Binding IsCurrent, Mode=OneWay}" />
              <Setter Property="Command" Value="{Binding Command}" />
            </Style>
          </MenuItem.ItemContainerStyle>
        </MenuItem>
        <Separator />
        <MenuItem Header="_Probe selected" Command="{Binding ProbeSelectedCommand}"
                  ToolTip="Read-only: logs in over FTP and lists md:, reads the summary file, asks KCL for $VERSION. Says what it is and what is locked." />
        <MenuItem Header="Probe a_ll" Command="{Binding ProbeAllCommand}" />
        <MenuItem Header="_Capture for support..." Command="{Binding CaptureCommand}"
                  ToolTip="Read-only: every diagnostic page the controller lists, a few FTP files, two KCL SHOWs, what RobControl made of each, its newest backup and event log - one folder and a zip." />
        <MenuItem Header="Open ca_ptures folder" Command="{Binding OpenCapturesCommand}" />
        <Separator />
        <MenuItem Header="_Diagnose network in NetControl" Command="{Binding DiagnoseNetworkCommand}"
                  ToolTip="Opens NetControl on this robot's address - for when it does not answer at all." />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="_Backup">
        <MenuItem Header="Back up _selected" Command="{Binding BackupSelectedCommand}"
                  ToolTip="Every robot selected in the list - Ctrl-click or Shift-click to pick several." />
        <MenuItem Header="Back up _all" Command="{Binding BackupAllCommand}" />
        <MenuItem Header="S_top" Command="{Binding StopCommand}"
                  ToolTip="Stops after the file being copied. Anything cut short is marked INCOMPLETE." />
        <Separator />
        <MenuItem Header="_What changed..." Command="{Binding WhatChangedCommand}"
                  ToolTip="Each robot's newest complete backup against the one before it: programs, settings and DCS files that changed, with the changed program lines. From the archive; nothing is sent to a robot." />
        <MenuItem Header="_Compare backups" Command="{Binding CompareCommand}"
                  ToolTip="The two ticked backups - or, with none ticked, the newest against the one before it." />
        <Separator />
        <MenuItem Header="Backup settings for this _system..." Command="{Binding EditSystemCommand}"
                  ToolTip="Which devices a backup starts with, folders, files to leave out. Back up still asks each time; a scheduled backup uses these as they are." />
        <MenuItem Header="Sc_hedule while open">
          <MenuItem Header="_Off" Command="{Binding SetScheduleCommand}" CommandParameter="0" />
          <MenuItem Header="Every _4 hours" Command="{Binding SetScheduleCommand}" CommandParameter="4" />
          <MenuItem Header="Every _8 hours" Command="{Binding SetScheduleCommand}" CommandParameter="8" />
          <MenuItem Header="Every _12 hours" Command="{Binding SetScheduleCommand}" CommandParameter="12" />
          <MenuItem Header="Every _24 hours" Command="{Binding SetScheduleCommand}" CommandParameter="24" />
        </MenuItem>
        <Separator />
        <MenuItem Header="C_hoose archive folder..." Command="{Binding ChooseArchiveCommand}" />
        <MenuItem Header="_Open archive folder" Command="{Binding OpenArchiveCommand}" />
        <MenuItem Header="_Refresh from disk" Command="{Binding RefreshCommand}"
                  ToolTip="Re-reads every manifest in the archive - for backups copied in from elsewhere." />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Appearance..." Click="OnAppearance"
                  ToolTip="Theme, accent and density - the same three axes as NetControl and Redline PDF." />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_Read me" Click="OnReadme" InputGestureText="F1"
                  ToolTip="How to use RobControl - the README of the version that is running." />
        <MenuItem Header="What's _new" Click="OnWhatsNew"
                  ToolTip="The changelog: what changed in each version." />
        <Separator />
        <MenuItem Header="Check for _updates" Click="OnCheckForUpdates" />
        <MenuItem Header="_Releases page" Click="OnOpenReleases" />
        <Separator />
        <MenuItem Header="Open the _diagnostic log folder" Click="OnOpenLogFolder"
                  ToolTip="Why the application misbehaved. Not the event log - that is in the fleet database and nothing can edit it." />
        <Separator />
        <MenuItem Header="_About RobControl" Click="OnAbout" />
      </MenuItem>
    </Menu>

    <!-- ============================== Toolbar ============================== -->
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="10,2,10,0" Padding="10,6">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <Button Content="Add robot" Command="{Binding AddRobotCommand}" />
          <Border Style="{StaticResource ToolbarSeparator}" />
          <Button Content="Probe" Command="{Binding ProbeSelectedCommand}"
                  ToolTip="Read-only check of the selected robot: what it is, and which ways in are open." />
          <Button Content="Back up" Style="{StaticResource PrimaryButton}" Command="{Binding BackupSelectedCommand}"
                  ToolTip="FTP copy into the archive - asks which devices first. RETR only - nothing is written to the robot." />
          <Button Content="Back up all" Command="{Binding BackupAllCommand}" />
          <Button Content="Stop" Command="{Binding StopCommand}" />
          <Border Style="{StaticResource ToolbarSeparator}" />
          <Button Content="Compare" Command="{Binding CompareCommand}" />
          <Button Content="What changed" Command="{Binding WhatChangedCommand}"
                  ToolTip="Each robot's newest complete backup against the one before it - programs, settings, DCS. From the archive only." />
          <Border Style="{StaticResource ToolbarSeparator}" />
          <Button Content="Site visit" Command="{Binding SiteVisitCommand}"
                  ToolTip="Every robot of this system in turn: probe, back up, capture - then one report and one zip. Read-only." />
          <Button Content="Diagnose network" Command="{Binding DiagnoseNetworkCommand}"
                  ToolTip="Opens NetControl on this robot's address." />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Text="{Binding TargetText}" FontWeight="SemiBold" Margin="0,0,14,0" />
          <TextBlock Style="{StaticResource Muted}" Text="Read-only: RobControl never writes to a controller." />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Margin="10,8,10,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*" MinWidth="380" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="6*" MinWidth="420" />
      </Grid.ColumnDefinitions>

      <!-- ============================== Fleet ============================== -->
      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="4">
        <DataGrid ItemsSource="{Binding Robots}"
                  SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Extended"
                  SelectionChanged="OnRobotSelectionChanged"
                  ToolTip="Ctrl-click or Shift-click to select several robots: Probe, Back up and everything on the Trends tab act on all of them."
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  BorderThickness="0"
                  MouseDoubleClick="OnRobotDoubleClick">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="" Width="26">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:RobotRowViewModel}">
                  <Ellipse Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Fill="{Binding State, Converter={StaticResource ReadinessBrush}}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Robot" Width="110" Binding="{Binding Name, Mode=OneWay}" />
            <DataGridTextColumn Header="Address" Width="105" Binding="{Binding Address, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
            <DataGridTextColumn Header="Line" Width="80" Binding="{Binding Line, Mode=OneWay}" />
            <DataGridTextColumn Header="Last good backup" Width="150" Binding="{Binding LastGoodBackup, Mode=OneWay}" />
            <DataGridTemplateColumn Header="Activity" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:RobotRowViewModel}">
                  <Grid>
                    <ProgressBar Height="4" VerticalAlignment="Bottom" Minimum="0" Maximum="100"
                                 Value="{Binding Progress, Mode=OneWay}"
                                 Foreground="{DynamicResource accent}" Background="Transparent" BorderThickness="0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding Activity}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Activity}" />
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />

      <!-- ============================== Selected robot ============================== -->
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
        <TabControl x:Name="DetailTabs">

          <TabItem Header="Overview">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="14,12" DataContext="{Binding Selected}">
                <TextBlock Style="{StaticResource PanelTitle}" Text="{Binding Name}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,10">
                  <Run Text="{Binding Address, Mode=OneWay}" />
                  <Run Text="  " />
                  <Run Text="{Binding Line, Mode=OneWay}" />
                </TextBlock>

                <TextBlock Style="{StaticResource PanelHead}" Text="CONTROLLER" />
                <TextBlock Text="{Binding Controller}" TextWrapping="Wrap" Margin="0,2,0,10" />

                <TextBlock Style="{StaticResource PanelHead}" Text="BACKUPS" />
                <TextBlock Margin="0,2,0,0"><Run Text="Last: " /><Run Text="{Binding LastBackup, Mode=OneWay}" /></TextBlock>
                <TextBlock Margin="0,0,0,10"><Run Text="Last complete: " /><Run Text="{Binding LastGoodBackup, Mode=OneWay}" /></TextBlock>

                <TextBlock Style="{StaticResource PanelHead}" Text="LAST PROBE" />
                <TextBlock Text="{Binding ProbeSummary}" TextWrapping="Wrap" Margin="0,2,0,6" />
                <ItemsControl ItemsSource="{Binding ProbeSteps}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="10,6">
                        <StackPanel>
                          <TextBlock>
                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text=" - " />
                            <Run Text="{Binding Outcome, Mode=OneWay}" />
                          </TextBlock>
                          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Style="{StaticResource Muted}" />
                          <TextBlock Text="{Binding Remediation}" TextWrapping="Wrap" Style="{StaticResource MutedWarning}"
                                     Visibility="{Binding Remediation, Converter={StaticResource NotNullToVisible}}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Backups">
            <DockPanel Margin="8">
              <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="2,0,0,6" TextWrapping="Wrap"
                         Text="Tick two to compare them, or press Compare with none ticked for newest vs previous. Double-click opens the folder. Select a backup to see the files that did not copy, and why." />
              <!-- Docked before the grid so the grid keeps the remaining space. Shown only for a
                   backup that has files missing, skipped or left out; a TextBox so it can be copied. -->
              <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0"
                         DataContext="{Binding SelectedItem, ElementName=BackupGrid}"
                         Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisible}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedWarning}" Margin="2,0,0,4"
                           Text="Files not in this backup - the FTP transcript in its folder has the controller's exact replies:" />
                <TextBox Text="{Binding Problems, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap"
                         MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="{DynamicResource mono}" />
              </DockPanel>
              <DataGrid x:Name="BackupGrid"
                        ItemsSource="{Binding Selected.Backups}"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        SelectionMode="Single"
                        HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal"
                        RowHeaderWidth="0"
                        BorderThickness="0"
                        MouseDoubleClick="OnBackupDoubleClick">
                <DataGrid.Columns>
                  <!-- A template column, not DataGridCheckBoxColumn: that one needs a click to enter edit
                       mode and a second to tick, which reads as a broken checkbox. -->
                  <DataGridTemplateColumn Header="" Width="30">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type vm:BackupRowViewModel}">
                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                  IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="" Width="22" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type vm:BackupRowViewModel}">
                        <Ellipse Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Fill="{Binding State, Converter={StaticResource ReadinessBrush}}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Taken" Width="125" IsReadOnly="True" Binding="{Binding When, Mode=OneWay}" />
                  <DataGridTextColumn Header="Outcome" Width="75" IsReadOnly="True" Binding="{Binding Outcome, Mode=OneWay}" />
                  <DataGridTextColumn Header="Files" Width="45" IsReadOnly="True" Binding="{Binding Files, Mode=OneWay}" />
                  <DataGridTextColumn Header="Size" Width="65" IsReadOnly="True" Binding="{Binding Size, Mode=OneWay}" />
                  <DataGridTextColumn Header="Summary" Width="*" IsReadOnly="True" Binding="{Binding Summary, Mode=OneWay}" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>

          <TabItem Header="Live">
            <DockPanel Margin="8" DataContext="{Binding Live}">
              <StackPanel DockPanel.Dock="Top">
                <WrapPanel>
                  <Button Content="Read now" Style="{StaticResource PrimaryButton}" Command="{Binding ReadNowCommand}" Margin="0,0,10,0"
                          ToolTip="GETs the controller's own diagnostic pages: active alarms, alarm history, program state, current position, stop signals, I/O, Ethernet and the EtherNet/IP log. Reads only." />
                  <CheckBox Content="Every" IsChecked="{Binding AutoRefresh}" VerticalAlignment="Center" Margin="0,0,6,0"
                            ToolTip="Reads again on a timer while this robot stays selected. Never faster than every 5 s, and skipped while it is being backed up, probed or recorded." />
                  <TextBox Text="{Binding IntervalSeconds, UpdateSourceTrigger=LostFocus}" Width="44" FontFamily="{DynamicResource mono}" />
                  <TextBlock Text="s" VerticalAlignment="Center" Margin="4,0,0,0" />
                </WrapPanel>
                <TextBlock Style="{StaticResource Muted}" Text="{Binding Status}" TextWrapping="Wrap" Margin="2,6,0,6" />
              </StackPanel>

              <TabControl>
                <TabItem Header="Alarms">
                  <Grid Margin="4">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" MinHeight="60" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="2*" MinHeight="80" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource PanelHead}" Text="ACTIVE NOW (ERRACT.LS)" Margin="2,0,0,4" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding ActiveAlarms}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" RowHeaderWidth="0" BorderThickness="0">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="When" Width="125" Binding="{Binding When, Mode=OneWay, StringFormat=g}" />
                        <DataGridTextColumn Header="Alarm" Width="85" Binding="{Binding Code, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                        <DataGridTextColumn Header="Message" Width="*" Binding="{Binding Message, Mode=OneWay}" />
                      </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Style="{StaticResource PanelHead}" Text="RECENT HISTORY (ERRALL.LS, NEWEST 50)" Margin="2,10,0,4" />
                    <DataGrid Grid.Row="3" ItemsSource="{Binding RecentAlarms}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" RowHeaderWidth="0" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="When" Width="125" Binding="{Binding When, Mode=OneWay, StringFormat=g}" />
                        <DataGridTextColumn Header="Alarm" Width="85" Binding="{Binding Code, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                        <DataGridTextColumn Header="Message" Width="*" Binding="{Binding Message, Mode=OneWay}" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </Grid>
                </TabItem>

                <TabItem Header="Why stopped?"
                         ToolTip="Why won't it run: alarms, stop signals, the UOP that hold it, paused tasks - and where each task is waiting, from the newest backup's listings.">
                  <Grid Margin="4">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" MinHeight="80" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" MinHeight="80" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding RunSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,0,0,6" />
                    <TextBlock Grid.Row="1" Style="{StaticResource PanelHead}" Margin="2,0,0,4"
                               Text="WHY IT WOULD NOT RUN (UOP BY THE STANDARD ASSIGNMENT; THE CONTROLLER'S OWN COMMENT IS SHOWN WHEN IT DIFFERS)" />
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Blockers}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" RowHeaderWidth="0" BorderThickness="0" ClipboardCopyMode="IncludeHeader">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="" Width="70" Binding="{Binding LevelText, Mode=OneWay}">
                          <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding LevelText}" Value="Stops it">
                                  <Setter Property="Foreground" Value="{DynamicResource bad}" />
                                  <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LevelText}" Value="Holds it">
                                  <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="What" Width="230" Binding="{Binding What, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                        <DataGridTextColumn Header="Why" Width="*" Binding="{Binding Why, Mode=OneWay}">
                          <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                              <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                          </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Where to look" Width="*" Binding="{Binding Where, Mode=OneWay}">
                          <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                              <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                          </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                      </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="3" Style="{StaticResource PanelHead}" Margin="2,10,0,4"
                               Text="WHERE EACH TASK IS WAITING (THE LINE IS FROM THE NEWEST BACKUP'S LISTING; THE SIGNALS ARE LIVE)" />
                    <DataGrid Grid.Row="4" ItemsSource="{Binding WaitLines}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" RowHeaderWidth="0" BorderThickness="0" ClipboardCopyMode="IncludeHeader">
                      <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                          <Setter Property="ToolTip" Value="{Binding Note}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWaitingOnASignal}" Value="True">
                              <Setter Property="Background" Value="{DynamicResource row-bad}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </DataGrid.RowStyle>
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Task" Width="110" Binding="{Binding Task, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                        <DataGridTextColumn Header="Status" Width="75" Binding="{Binding Status, Mode=OneWay}" />
                        <DataGridTextColumn Header="Program" Width="110" Binding="{Binding Program, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                        <DataGridTextColumn Header="Line" Width="45" Binding="{Binding Line, Mode=OneWay}" />
                        <DataGridTextColumn Header="Text" Width="2*" Binding="{Binding Text, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                        <DataGridTextColumn Header="Signals on the line (now)" Width="2*" Binding="{Binding SignalsText, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                        <DataGridTextColumn Header="Note" Width="*" Binding="{Binding Note, Mode=OneWay}" ElementStyle="{StaticResource Muted}" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </Grid>
                </TabItem>

                <TabItem Header="I/O">
                  <DockPanel Margin="4">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                      <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,6,0" />
                      <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,12,0"
                               ToolTip="Matches the point or its comment: DO[, UI[, gun, clamp, estop. DIN and DOUT (as the page writes them) work too." />
                      <ComboBox ItemsSource="{Binding IoCategories}" SelectedItem="{Binding IoCategory}" Width="210" Margin="0,0,12,0"
                                ToolTip="One kind of I/O at a time. Safe I/O (DCS / CIP Safety) appears here when the controller lists it on its I/O page." />
                      <CheckBox Content="Only ON" IsChecked="{Binding OnlyOn}" VerticalAlignment="Center" Margin="0,0,12,0"
                                ToolTip="Only points that are ON or TRUE, and group or analog values that are not zero." />
                      <CheckBox Content="Named only" IsChecked="{Binding NamedOnly}" VerticalAlignment="Center" Margin="0,0,12,0"
                                ToolTip="Hide points with no I/O comment - most of a 2,000-point rack is unused." />
                      <TextBlock Style="{StaticResource Muted}" Text="{Binding IoCount}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </WrapPanel>
                    <DataGrid ItemsSource="{Binding Io}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" RowHeaderWidth="0" BorderThickness="0"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              EnableRowVirtualization="True" ClipboardCopyMode="IncludeHeader">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Type" Width="170" Binding="{Binding Category, Mode=OneWay}" />
                        <DataGridTextColumn Header="Point" Width="130" Binding="{Binding Name, Mode=OneWay}">
                          <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                              <Setter Property="ToolTip" Value="{Binding Listed}" />
                            </Style>
                          </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="State" Width="70" Binding="{Binding State, Mode=OneWay}">
                          <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOn}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource good}" />
                                  <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                  <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsOn}" Value="True" />
                                    <Condition Binding="{Binding Category}" Value="Stop signals" />
                                  </MultiDataTrigger.Conditions>
                                  <Setter Property="Foreground" Value="{DynamicResource bad}" />
                                </MultiDataTrigger>
                              </Style.Triggers>
                            </Style>
                          </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Direction" Width="75" Binding="{Binding Direction, Mode=OneWay}" />
                        <DataGridTextColumn Header="Comment" Width="*" Binding="{Binding Comment, Mode=OneWay}" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </DockPanel>
                </TabItem>

                <TabItem Header="Program">
                  <Grid Margin="4">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" MinHeight="70" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="2*" MinHeight="90" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                      <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,6,0" />
                      <TextBox Text="{Binding ProgramFilter, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,12,0"
                               ToolTip="Matches names, comments, status, program type, where a task is, and source file." />
                      <CheckBox Content="Running only" IsChecked="{Binding RunningOnly}" VerticalAlignment="Center" Margin="0,0,12,0" />
                      <TextBlock Style="{StaticResource Muted}" Text="{Binding ProgramCount}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </WrapPanel>
                    <TextBlock Grid.Row="1" Style="{StaticResource PanelHead}" Text="TASKS" Margin="2,0,0,4" />
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Tasks}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" RowHeaderWidth="0" BorderThickness="0" ClipboardCopyMode="IncludeHeader">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Width="40" Binding="{Binding Number, Mode=OneWay}" />
                        <DataGridTextColumn Header="Task" Width="130" Binding="{Binding Name, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                        <DataGridTextColumn Header="Status" Width="80" Binding="{Binding Status, Mode=OneWay}">
                          <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource good}" />
                                  <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="At" Width="260" Binding="{Binding Where, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                        <DataGridTextColumn Header="Call stack (outermost first)" Width="*" Binding="{Binding CallStack, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                      </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="3" Style="{StaticResource PanelHead}" Text="PROGRAMS LOADED (HOVER A ROW FOR EVERY FIELD)" Margin="2,10,0,4" />
                    <DataGrid Grid.Row="4" ItemsSource="{Binding Programs}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" RowHeaderWidth="0" BorderThickness="0" ClipboardCopyMode="IncludeHeader"
                              VirtualizingPanel.IsVirtualizing="True" EnableRowVirtualization="True">
                      <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                          <Setter Property="ToolTip" Value="{Binding Details}" />
                        </Style>
                      </DataGrid.RowStyle>
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Program" Width="140" Binding="{Binding Name, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                        <DataGridTextColumn Header="Type" Width="60" Binding="{Binding Type, Mode=OneWay}" />
                        <DataGridTextColumn Header="Comment" Width="*" MinWidth="120" Binding="{Binding Comment, Mode=OneWay}" />
                        <DataGridTextColumn Header="Task" Width="70" Binding="{Binding Status, Mode=OneWay}" />
                        <DataGridTextColumn Header="Lines" Width="55" Binding="{Binding Lines, Mode=OneWay}" />
                        <DataGridTextColumn Header="Bytes" Width="65" Binding="{Binding Size, Mode=OneWay, StringFormat=N0}" />
                        <DataGridTextColumn Header="Modified" Width="125" Binding="{Binding ModifiedText, Mode=OneWay}" SortMemberPath="Modified" />
                        <DataGridTextColumn Header="Source" Width="150" Binding="{Binding Source, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                        <DataGridTextColumn Header="Write" Width="70" Binding="{Binding Protection, Mode=OneWay}" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </Grid>
                </TabItem>

                <TabItem Header="Position">
                  <DockPanel Margin="4">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Text="{Binding PositionNote}" TextWrapping="Wrap" Margin="2,0,0,8" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="320" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" MaxWidth="440" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHead}" Text="JOINTS" Margin="2,0,0,4" />
                        <DataGrid ItemsSource="{Binding Joints}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" RowHeaderWidth="0" BorderThickness="0" ClipboardCopyMode="IncludeHeader">
                          <DataGrid.Columns>
                            <DataGridTextColumn Header="Group" Width="50" Binding="{Binding Group, Mode=OneWay}" />
                            <DataGridTextColumn Header="Axis" Width="50" Binding="{Binding Axis, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                            <DataGridTextColumn Header="Value" Width="*" Binding="{Binding Value, Mode=OneWay}">
                              <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                                  <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                              </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Unit" Width="40" Binding="{Binding Unit, Mode=OneWay}" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </DockPanel>
                      <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHead}" Text="CARTESIAN" Margin="2,0,0,4" />
                        <DataGrid ItemsSource="{Binding Cartesian}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" RowHeaderWidth="0" BorderThickness="0" ClipboardCopyMode="IncludeHeader">
                          <DataGrid.Columns>
                            <DataGridTextColumn Header="Group" Width="50" Binding="{Binding Group, Mode=OneWay}" />
                            <DataGridTextColumn Header="Axis" Width="50" Binding="{Binding Axis, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                            <DataGridTextColumn Header="User frame" Width="*" Binding="{Binding User, Mode=OneWay}">
                              <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                                  <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                              </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="World" Width="*" Binding="{Binding World, Mode=OneWay}">
                              <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                                  <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                              </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Unit" Width="40" Binding="{Binding Unit, Mode=OneWay}" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </DockPanel>
                    </Grid>
                  </DockPanel>
                </TabItem>

                <TabItem Header="Network"
                         ToolTip="The Ethernet page's values and the EtherNet/IP log, error counters and faults flagged. Layouts not yet seen on a real controller - the Pages tab has both files whole.">
                  <DockPanel Margin="4">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                      <CheckBox Content="Only what is flagged" IsChecked="{Binding NetworkConcernsOnly}" VerticalAlignment="Center" Margin="0,0,12,0" />
                      <TextBlock Style="{StaticResource Muted}" Text="{Binding NetworkSummary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </WrapPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHead}" Text="ETHERNET (ETHERNET.DG)" Margin="2,0,0,4" />
                        <DataGrid ItemsSource="{Binding NetworkCounters}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" RowHeaderWidth="0" BorderThickness="0" ClipboardCopyMode="IncludeHeader">
                          <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Concern}" Value="True">
                                  <Setter Property="Background" Value="{DynamicResource row-bad}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </DataGrid.RowStyle>
                          <DataGrid.Columns>
                            <DataGridTextColumn Header="Section" Width="110" Binding="{Binding Section, Mode=OneWay}" />
                            <DataGridTextColumn Header="Name" Width="*" Binding="{Binding Name, Mode=OneWay}" />
                            <DataGridTextColumn Header="Value" Width="*" Binding="{Binding Value, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </DockPanel>
                      <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHead}" Text="ETHERNET/IP LOG (EIPLOG.DG)" Margin="2,0,0,4" />
                        <DataGrid ItemsSource="{Binding NetworkLog}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" RowHeaderWidth="0" BorderThickness="0" ClipboardCopyMode="IncludeHeader"
                                  VirtualizingPanel.IsVirtualizing="True">
                          <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Concern}" Value="True">
                                  <Setter Property="Background" Value="{DynamicResource row-bad}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </DataGrid.RowStyle>
                          <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Width="40" Binding="{Binding Number, Mode=OneWay}" />
                            <DataGridTextColumn Header="Line" Width="*" Binding="{Binding Text, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </DockPanel>
                    </Grid>
                  </DockPanel>
                </TabItem>

                <TabItem Header="Pages">
                  <Grid Margin="4">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="6" />
                      <RowDefinition Height="*" MinHeight="80" />
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" MaxHeight="190"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" RowHeaderWidth="0" BorderThickness="0">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Page" Width="120" Binding="{Binding Title, Mode=OneWay}" />
                        <DataGridTextColumn Header="File" Width="100" Binding="{Binding FileName, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                        <DataGridTextColumn Header="Result" Width="90" Binding="{Binding Status, Mode=OneWay}" />
                        <DataGridTextColumn Header="Why" Width="*" Binding="{Binding Message, Mode=OneWay}" />
                      </DataGrid.Columns>
                    </DataGrid>
                    <TextBox Grid.Row="2" Text="{Binding SelectedPageText, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="{DynamicResource mono}" TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                  </Grid>
                </TabItem>
              </TabControl>
            </DockPanel>
          </TabItem>

          <TabItem x:Name="ChangesTab" Header="Changes">
            <views:ChangesPanel DataContext="{Binding Compare}" />
          </TabItem>

          <TabItem x:Name="TrendsTab" Header="Trends">
            <DockPanel Margin="8" DataContext="{Binding Trend}">

              <!-- What is being acted on, and the controls. Everything here applies to every robot
                   selected in the list on the left. -->
              <StackPanel DockPanel.Dock="Top" Margin="2,0,0,6">
                <TextBlock Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis">
                  <Run Text="Acting on: " /><Run Text="{Binding Targets, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
                <DockPanel Margin="0,6,0,0">
                  <Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding BrowseCommand}" Margin="6,0,0,0"
                          ToolTip="Pick from a list: registers and I/O with their comments, and system variables, from the first selected robot's newest backup - or read from the robot itself." />
                  <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddCommand}" Margin="6,0,0,0" />
                  <TextBox Text="{Binding AddText, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource mono}"
                           ToolTip="As on the pendant, comma separated, ranges allowed: R[1-10], DI[1..8], GI[1], $TIMER[1].$TIMER_VAL. Added to every selected robot. Or Browse to pick from a list." />
                </DockPanel>
                <WrapPanel Margin="0,6,0,0">
                  <Button Content="Read now" Command="{Binding ReadNowCommand}"
                          ToolTip="One read of every signal on every selected robot. Nothing is stored." />
                  <Border Style="{StaticResource ToolbarSeparator}" />
                  <TextBlock Text="Every" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <TextBox Width="44" Text="{Binding IntervalSeconds, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource mono}"
                           ToolTip="Seconds between polls, per robot. Never faster than 2 s." />
                  <TextBlock Text="s" VerticalAlignment="Center" Margin="4,0,8,0" />
                  <Button Content="Start recording" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}"
                          ToolTip="Records every selected robot at once, each on its own loop. Only changes are stored, plus one value a minute." />
                  <Button Content="Stop" Command="{Binding StopCommand}" ToolTip="Stops the selected robots." />
                  <Button Content="Stop all" Command="{Binding StopAllCommand}" />
                  <CheckBox Content="Snapshot on new alarm" IsChecked="{Binding SnapshotOnAlarm}" VerticalAlignment="Center" Margin="8,0,0,0"
                            Visibility="{Binding CanSnapshot, Converter={StaticResource BoolToVisible}}"
                            ToolTip="While recording, the active alarms are looked at every 10 s on the same connection. A new one saves the Live pages - I/O, program and line, position, stop signals - as they were at that moment: Alarms &gt; Snapshots. With no signals on a robot, Start only watches its alarms. GET only." />
                  <Border Style="{StaticResource ToolbarSeparator}" />
                  <Button Content="Remove signal" Command="{Binding RemoveCommand}" />
                  <Button Content="Export CSV" Command="{Binding ExportCommand}"
                          ToolTip="The plotted signals, in the window shown, one row per stored sample." />
                </WrapPanel>
                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="{Binding Status}" TextWrapping="Wrap" />
              </StackPanel>

              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="2*" MinHeight="90" />
                  <RowDefinition Height="6" />
                  <RowDefinition Height="3*" MinHeight="140" />
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding Rows}"
                          SelectedItem="{Binding SelectedSignal}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          BorderThickness="0"
                          VirtualizingPanel.IsVirtualizing="True">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Plot" Width="38">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:SignalRowViewModel}">
                          <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsChecked="{Binding IsPlotted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="22" IsReadOnly="True">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:SignalRowViewModel}">
                          <Ellipse Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Fill="{Binding State, Converter={StaticResource ReadinessBrush}}"
                                   ToolTip="{Binding Problem}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Robot" Width="90" IsReadOnly="True" Binding="{Binding RobotName, Mode=OneWay}" />
                    <DataGridTextColumn Header="Signal" Width="130" IsReadOnly="True" Binding="{Binding Address, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                    <DataGridTextColumn Header="Value" Width="90" IsReadOnly="True" Binding="{Binding Value, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                    <DataGridTextColumn Header="Read" Width="65" IsReadOnly="True" Binding="{Binding ReadAt, Mode=OneWay}" />
                    <DataGridTextColumn Header="From" Width="80" IsReadOnly="True" Binding="{Binding Source, Mode=OneWay}" ElementStyle="{StaticResource Muted}" />
                    <DataGridTemplateColumn Header="Problem" Width="*" IsReadOnly="True">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:SignalRowViewModel}">
                          <TextBlock Style="{StaticResource MutedWarning}" Text="{Binding Problem}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Problem}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" />

                <DockPanel Grid.Row="2">
                  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,2,0,4">
                    <TextBlock Text="Window" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Width="90" ItemsSource="{x:Static vm:TrendViewModel.Windows}" SelectedItem="{Binding Window}" />
                    <Button Content="Refresh" Command="{Binding RefreshChartCommand}" Margin="8,0,0,0" />
                  </StackPanel>
                  <TabControl>
                    <TabItem Header="Chart">
                      <Border BorderBrush="{DynamicResource line}" BorderThickness="1" CornerRadius="{DynamicResource corner-sm}" ClipToBounds="True">
                        <views:TrendChart Series="{Binding Series}" From="{Binding From}" To="{Binding To}" />
                      </Border>
                    </TabItem>
                    <TabItem Header="Timing (I/O watch)"
                             ToolTip="The plotted digital signals: how long each has held its state, and every change in the window. Good to one recording interval - a pulse shorter than that can be missed.">
                      <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="8" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0">
                          <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHead}" Text="NOW - LONGEST HELD FIRST" Margin="2,0,0,4" />
                          <DataGrid ItemsSource="{Binding Holds}"
                                    AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" HeadersVisibility="Column"
                                    GridLinesVisibility="Horizontal" RowHeaderWidth="0" BorderThickness="0" ClipboardCopyMode="IncludeHeader">
                            <DataGrid.RowStyle>
                              <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Stuck}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource row-bad}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                              <DataGridTextColumn Header="Signal" Width="*" Binding="{Binding Signal, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                              <DataGridTextColumn Header="Comment" Width="*" Binding="{Binding Comment, Mode=OneWay}" />
                              <DataGridTextColumn Header="State" Width="50" Binding="{Binding State, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                              <DataGridTextColumn Header="Held for" Width="150" Binding="{Binding HeldText, Mode=OneWay}" />
                              <DataGridTextColumn Header="Changes" Width="60" Binding="{Binding Changes, Mode=OneWay}" />
                            </DataGrid.Columns>
                          </DataGrid>
                        </DockPanel>
                        <DockPanel Grid.Column="2">
                          <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHead}" Text="CHANGES - NEWEST FIRST" Margin="2,0,0,4" />
                          <DataGrid ItemsSource="{Binding Transitions}"
                                    AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" HeadersVisibility="Column"
                                    GridLinesVisibility="Horizontal" RowHeaderWidth="0" BorderThickness="0" ClipboardCopyMode="IncludeHeader"
                                    VirtualizingPanel.IsVirtualizing="True" EnableRowVirtualization="True">
                            <DataGrid.Columns>
                              <DataGridTextColumn Header="When" Width="70" Binding="{Binding When, Mode=OneWay}" />
                              <DataGridTextColumn Header="Signal" Width="*" Binding="{Binding Signal, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                              <DataGridTextColumn Header="Change" Width="85" Binding="{Binding Change, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                              <DataGridTextColumn Header="Had held" Width="95" Binding="{Binding HeldText, Mode=OneWay}" />
                            </DataGrid.Columns>
                          </DataGrid>
                        </DockPanel>
                      </Grid>
                    </TabItem>
                  </TabControl>
                </DockPanel>
              </Grid>
            </DockPanel>
          </TabItem>

          <!-- ============ Fleet-wide tabs: read the archive, never a robot ============ -->

          <TabItem Header="Search">
            <views:SearchPanel DataContext="{Binding Search}" />
          </TabItem>

          <TabItem Header="Alarms">
            <TabControl Margin="4">
              <TabItem Header="History">
                <views:AlarmHistoryPanel DataContext="{Binding Alarms}" />
              </TabItem>
              <TabItem Header="Cell timeline"
                       ToolTip="Every robot's alarms on one time axis, grouped into incidents, with the robot that went first.">
                <views:TimelinePanel DataContext="{Binding Timeline}" />
              </TabItem>
              <TabItem Header="Snapshots"
                       ToolTip="The state a robot was in when a new alarm appeared while it was recorded (Trends: Snapshot on new alarm).">
                <DockPanel Margin="8" DataContext="{Binding Snapshots}">
                  <StackPanel DockPanel.Dock="Top">
                    <WrapPanel>
                      <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,10,0" />
                      <Button Content="Open" Style="{StaticResource PrimaryButton}" Command="{Binding ShowCommand}" Margin="0,0,10,0"
                              ToolTip="The selected snapshot as a document: the alarm, why it would not run, tasks and lines, stop signals, UOP, outputs, position." />
                      <Button Content="Open folder" Command="{Binding OpenFolderCommand}"
                              ToolTip="The snapshot's folder: snapshot.md and every page read, exactly as the controller wrote it." />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding Status}" TextWrapping="Wrap" Margin="2,6,0,6" />
                  </StackPanel>
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*" MinHeight="80" />
                      <RowDefinition Height="6" />
                      <RowDefinition Height="2*" MinHeight="80" />
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding Selected}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" RowHeaderWidth="0" BorderThickness="0" ClipboardCopyMode="IncludeHeader">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="When" Width="135" Binding="{Binding When, Mode=OneWay}" />
                        <DataGridTextColumn Header="Robot" Width="110" Binding="{Binding Robot, Mode=OneWay}" />
                        <DataGridTextColumn Header="New alarm" Width="*" Binding="{Binding AlarmsText, Mode=OneWay}" />
                        <DataGridTextColumn Header="Why it stopped" Width="*" Binding="{Binding Summary, Mode=OneWay}" />
                      </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="Transparent" />
                    <TextBox Grid.Row="2" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" FontFamily="{DynamicResource mono}"
                             TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                  </Grid>
                </DockPanel>
              </TabItem>
            </TabControl>
          </TabItem>

          <TabItem Header="Fleet">
            <DockPanel Margin="8" DataContext="{Binding Fleet}">
              <StackPanel DockPanel.Dock="Top">
                <WrapPanel>
                  <Button Content="Refresh" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,6,0" />
                  <Button Content="Export CSV..." Command="{Binding ExportCsvCommand}" Margin="0,0,6,0" />
                  <Button Content="Site report..." Command="{Binding ReportCommand}" Margin="0,0,10,0"
                          ToolTip="One page for the visit: backup status, alarms needing a job, frequent alarms, watched setting changes and site notes. Opens in the browser to print or save as PDF." />
                  <TextBlock Text="Changes in the last" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}" Width="100" Margin="0,0,16,0" />
                  <Button Content="Verify backups" Command="{Binding VerifyCommand}" Margin="0,0,6,0"
                          ToolTip="Re-reads each robot's newest backup from disk and checks every file against the SHA-256 recorded when it was taken. Reads the disk only - nothing is sent to a robot." />
                  <CheckBox Content="All, not just the newest" IsChecked="{Binding VerifyAll}" VerticalAlignment="Center" Margin="0,0,10,0"
                            ToolTip="Check every backup in the archive. Slower; worth doing before relying on an old one." />
                  <Button Content="Prune old backups..." Command="{Binding PruneCommand}"
                          ToolTip="Shows how many old backups are past the site's Keep setting, and on Yes sends them to the Recycle Bin. Never runs by itself. Off until Keep is set in Site settings." />
                </WrapPanel>
                <TextBlock Style="{StaticResource Muted}" Text="{Binding Status}" TextWrapping="Wrap" Margin="2,6,0,6" />
              </StackPanel>

              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" MinHeight="80" />
                  <RowDefinition Height="*" MinHeight="120" />
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0" ItemsSource="{Binding Rows}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" RowHeaderWidth="0" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Robot" Width="100" Binding="{Binding Robot, Mode=OneWay}" />
                    <DataGridTextColumn Header="Address" Width="95" Binding="{Binding Address, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                    <DataGridTextColumn Header="Line" Width="70" Binding="{Binding Line, Mode=OneWay}" />
                    <DataGridTextColumn Header="Controller" Width="90" Binding="{Binding Controller, Mode=OneWay}" />
                    <DataGridTextColumn Header="Model" Width="110" Binding="{Binding Model, Mode=OneWay}" />
                    <DataGridTextColumn Header="Software" Width="*" Binding="{Binding Software, Mode=OneWay}" />
                    <DataGridTextColumn Header="F-number" Width="75" Binding="{Binding FNumber, Mode=OneWay}" />
                    <DataGridTextColumn Header="Last complete" Width="115" Binding="{Binding LastComplete, Mode=OneWay}" />
                    <DataGridTextColumn Header="Age" Width="65" Binding="{Binding Age, Mode=OneWay}">
                      <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStale}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource bad}" />
                              <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Backups" Width="140" Binding="{Binding HealthText, Mode=OneWay}">
                      <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                          <Setter Property="ToolTip" Value="{Binding LastOutcome}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFailing}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource warn}" />
                              <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsBad}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource bad}" />
                              <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                  </DataGrid.Columns>
                </DataGrid>

                <!-- The lower half: three views of the same archive. Backup check fills when Verify runs. -->
                <TabControl Grid.Row="1" Margin="0,8,0,0" SelectedIndex="{Binding DetailTab}">
                  <TabItem Header="Setting changes"
                           ToolTip="Watched setting changes between backups - frames, payload, mastering, reference positions, joint limits, DCS, software version.">
                    <DataGrid ItemsSource="{Binding Changes}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" RowHeaderWidth="0" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Backup" Width="125" Binding="{Binding NewerStamp, Mode=OneWay}" />
                        <DataGridTextColumn Header="Robot" Width="90" Binding="{Binding Robot, Mode=OneWay}" />
                        <DataGridTextColumn Header="What" Width="105" Binding="{Binding Category, Mode=OneWay}" />
                        <DataGridTextColumn Header="Variable" Width="120" Binding="{Binding Variable, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                        <DataGridTextColumn Header="Before" Width="*" Binding="{Binding OldText, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                        <DataGridTextColumn Header="After" Width="*" Binding="{Binding NewText, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </TabItem>
                  <TabItem Header="Network">
                    <DockPanel>
                      <DockPanel DockPanel.Dock="Top" Margin="0,4,0,4">
                        <Button DockPanel.Dock="Right" Content="Export CSV..." Command="{Binding ExportNetworkCommand}" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="From each robot's newest complete backup - the variable listings, matched by name. Which variables hold the TCP/IP settings is still to be confirmed on a real controller; a value is only shown when it looks like an address." />
                      </DockPanel>
                      <DataGrid ItemsSource="{Binding Network}"
                                AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                                GridLinesVisibility="Horizontal" RowHeaderWidth="0" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True">
                        <DataGrid.Columns>
                          <DataGridTextColumn Header="Robot" Width="100" Binding="{Binding Robot, Mode=OneWay}" />
                          <DataGridTextColumn Header="In robot list" Width="95" Binding="{Binding ListedAddress, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                          <DataGridTextColumn Header="Hostname" Width="100" Binding="{Binding Hostname, Mode=OneWay}" />
                          <DataGridTextColumn Header="Addresses in backup" Width="150" Binding="{Binding AddressText, Mode=OneWay}">
                            <DataGridTextColumn.ElementStyle>
                              <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding AddressMismatch}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource warn}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </DataGridTextColumn.ElementStyle>
                          </DataGridTextColumn>
                          <DataGridTextColumn Header="Subnet mask" Width="105" Binding="{Binding SubnetMask, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                          <DataGridTextColumn Header="Router" Width="95" Binding="{Binding Router, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                          <DataGridTextColumn Header="MAC" Width="130" Binding="{Binding Mac, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                          <DataGridTextColumn Header="Note" Width="*" Binding="{Binding Note, Mode=OneWay}" />
                        </DataGrid.Columns>
                      </DataGrid>
                    </DockPanel>
                  </TabItem>
                  <TabItem Header="Backup check" ToolTip="Verify backups: every file against the SHA-256 in its manifest. Damaged backups first.">
                    <DataGrid ItemsSource="{Binding Checks}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" RowHeaderWidth="0" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Robot" Width="100" Binding="{Binding Robot, Mode=OneWay}" />
                        <DataGridTextColumn Header="Backup" Width="170" Binding="{Binding FolderName, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                        <DataGridTextColumn Header="Files" Width="50" Binding="{Binding FilesChecked, Mode=OneWay}" />
                        <DataGridTextColumn Header="Result" Width="*" Binding="{Binding Summary, Mode=OneWay}">
                          <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                              <Setter Property="ToolTip" Value="{Binding FolderPath}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsIntact}" Value="False">
                                  <Setter Property="Foreground" Value="{DynamicResource bad}" />
                                  <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                      </DataGrid.Columns>
                    </DataGrid>
                  </TabItem>
                </TabControl>
              </Grid>
            </DockPanel>
          </TabItem>

          <TabItem Header="Event log">
            <DockPanel Margin="8">
              <DockPanel DockPanel.Dock="Top" Margin="2,0,0,6">
                <Button DockPanel.Dock="Right" Content="Export CSV..." Command="{Binding ExportEventsCommand}"
                        ToolTip="The whole event log of this site - or the selected robot's - as CSV: every probe, backup, KCL read and trend session, and what came back. For plant IT, or a FANUC engineer asking what this laptop did on their network." />
                <CheckBox Content="Only the selected robot" IsChecked="{Binding EventsForSelectedOnly}" VerticalAlignment="Center" />
              </DockPanel>
              <DataGrid ItemsSource="{Binding Events}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        SelectionMode="Single"
                        HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal"
                        RowHeaderWidth="0"
                        BorderThickness="0"
                        VirtualizingPanel.IsVirtualizing="True">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="" Width="22">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type vm:EventRowViewModel}">
                        <Ellipse Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Fill="{Binding State, Converter={StaticResource ReadinessBrush}}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="When" Width="135" Binding="{Binding When, Mode=OneWay}" />
                  <DataGridTextColumn Header="What" Width="60" Binding="{Binding Category, Mode=OneWay}" />
                  <DataGridTextColumn Header="Robot" Width="150" Binding="{Binding Robot, Mode=OneWay}" />
                  <DataGridTemplateColumn Header="Message" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type vm:EventRowViewModel}">
                        <TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>

        </TabControl>
      </Border>
    </Grid>

  </DockPanel>
</Window>
