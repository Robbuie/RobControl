<Window x:Class="RobControl.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RobControl.App.ViewModels"
        xmlns:views="clr-namespace:RobControl.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        Height="760" Width="1260"
        MinHeight="520" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ChromeWindow}">

  <!-- The title-bar menu is a resource handed to the shared title bar through Chrome.TitleContent in
       the constructor - attached-property element syntax for it trips MC3089 (see NetControl). -->
  <Window.Resources>
    <Menu x:Key="TitleMenu" Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center">
      <MenuItem Header="_Site">
        <!-- One line per site on this PC; each carries its own command (SiteChoiceViewModel). -->
        <MenuItem Header="_Switch to" ItemsSource="{Binding SiteChoices}">
          <MenuItem.ItemContainerStyle>
            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
              <Setter Property="Header" Value="{Binding Name}" />
              <Setter Property="IsChecked" Value="{Binding IsCurrent, Mode=OneWay}" />
              <Setter Property="Command" Value="{Binding Command}" />
            </Style>
          </MenuItem.ItemContainerStyle>
        </MenuItem>
        <Separator />
        <MenuItem Header="_New site..." Command="{Binding NewSiteCommand}"
                  ToolTip="A plant of its own: its own robot list, archive folder, schedule and event log." />
        <MenuItem Header="Site s_ettings..." Command="{Binding EditSiteCommand}"
                  ToolTip="Name, archive folder, robots at once, the FTP login new robots start with, notes." />
        <Separator />
        <MenuItem Header="_Import site file..." Command="{Binding ImportSiteCommand}"
                  ToolTip="Makes a new site from a file exported on another PC - settings and robot list." />
        <MenuItem Header="E_xport site file..." Command="{Binding ExportSiteCommand}"
                  ToolTip="This site's settings and robot list in one file, to carry to another PC. It includes FTP passwords." />
        <Separator />
        <MenuItem Header="Site _report..." Command="{Binding Fleet.ReportCommand}"
                  ToolTip="One page for the visit, from the backups: backup status, alarms needing a job, frequent alarms, watched setting changes, notes." />
        <MenuItem Header="_Open site folder" Command="{Binding OpenSiteFolderCommand}"
                  ToolTip="Where site.json and this site's database live. site.json can be edited by hand while the site is closed." />
      </MenuItem>
      <MenuItem Header="_Robots">
        <MenuItem Header="_Add robot..." Command="{Binding AddRobotCommand}" />
        <MenuItem Header="_Edit robot..." Command="{Binding EditRobotCommand}" />
        <MenuItem Header="_Remove robot" Command="{Binding RemoveRobotCommand}"
                  ToolTip="Takes it off the list. Its backups and its event log rows stay." />
        <Separator />
        <MenuItem Header="_Probe selected" Command="{Binding ProbeSelectedCommand}"
                  ToolTip="Read-only: logs in over FTP and lists md:, reads the summary file, asks KCL for $VERSION. Says what it is and what is locked." />
        <MenuItem Header="Probe a_ll" Command="{Binding ProbeAllCommand}" />
        <Separator />
        <MenuItem Header="_Diagnose network in NetControl" Command="{Binding DiagnoseNetworkCommand}"
                  ToolTip="Opens NetControl on this robot's address - for when it does not answer at all." />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="_Backup">
        <MenuItem Header="Back up _selected" Command="{Binding BackupSelectedCommand}"
                  ToolTip="Every robot selected in the list - Ctrl-click or Shift-click to pick several." />
        <MenuItem Header="Back up _all" Command="{Binding BackupAllCommand}" />
        <MenuItem Header="S_top" Command="{Binding StopCommand}"
                  ToolTip="Stops after the file being copied. Anything cut short is marked INCOMPLETE." />
        <Separator />
        <MenuItem Header="_Compare backups" Command="{Binding CompareCommand}"
                  ToolTip="The two ticked backups - or, with none ticked, the newest against the one before it." />
        <Separator />
        <MenuItem Header="Also copy _FR: (FROM)" IsCheckable="True" IsChecked="{Binding IncludeFrom}"
                  ToolTip="md: is what matters for a file backup. FR: can be large." />
        <MenuItem Header="Sc_hedule while open">
          <MenuItem Header="_Off" Command="{Binding SetScheduleCommand}" CommandParameter="0" />
          <MenuItem Header="Every _4 hours" Command="{Binding SetScheduleCommand}" CommandParameter="4" />
          <MenuItem Header="Every _8 hours" Command="{Binding SetScheduleCommand}" CommandParameter="8" />
          <MenuItem Header="Every _12 hours" Command="{Binding SetScheduleCommand}" CommandParameter="12" />
          <MenuItem Header="Every _24 hours" Command="{Binding SetScheduleCommand}" CommandParameter="24" />
        </MenuItem>
        <Separator />
        <MenuItem Header="C_hoose archive folder..." Command="{Binding ChooseArchiveCommand}" />
        <MenuItem Header="_Open archive folder" Command="{Binding OpenArchiveCommand}" />
        <MenuItem Header="_Refresh from disk" Command="{Binding RefreshCommand}"
                  ToolTip="Re-reads every manifest in the archive - for backups copied in from elsewhere." />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Appearance..." Click="OnAppearance"
                  ToolTip="Theme, accent and density - the same three axes as NetControl and Redline PDF." />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_Read me" Click="OnReadme" InputGestureText="F1"
                  ToolTip="How to use RobControl - the README of the version that is running." />
        <MenuItem Header="What's _new" Click="OnWhatsNew"
                  ToolTip="The changelog: what changed in each version." />
        <Separator />
        <MenuItem Header="Check for _updates" Click="OnCheckForUpdates" />
        <MenuItem Header="_Releases page" Click="OnOpenReleases" />
        <Separator />
        <MenuItem Header="Open the _diagnostic log folder" Click="OnOpenLogFolder"
                  ToolTip="Why the application misbehaved. Not the event log - that is in the fleet database and nothing can edit it." />
        <Separator />
        <MenuItem Header="_About RobControl" Click="OnAbout" />
      </MenuItem>
    </Menu>
  </Window.Resources>

  <DockPanel>

    <!-- ============================== Status bar ============================== -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource bg-1}"
            BorderBrush="{DynamicResource line}"
            BorderThickness="0,1,0,0"
            Padding="10,5">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Style="{StaticResource Muted}" Text="{Binding Status}"
                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <TextBlock Text="{Binding SiteName}" FontWeight="SemiBold" ToolTip="The open site. Site menu to switch." />
          <TextBlock Style="{StaticResource Muted}" Text="  -  " />
          <TextBlock Style="{StaticResource Muted}" Text="{Binding ScheduleText}" />
          <TextBlock Style="{StaticResource Muted}" Text="  -  " />
          <TextBlock Style="{StaticResource Muted}" Text="{Binding ArchiveRoot}" ToolTip="Archive folder" />
          <TextBlock Style="{StaticResource Muted}" Text="  -  " />
          <TextBlock Style="{StaticResource Muted}" Text="{Binding Version}" />
          <TextBlock Margin="10,0,0,0" Foreground="{DynamicResource accent-text}" Cursor="Hand"
                     Text="{Binding UpdateStatus}"
                     Visibility="{Binding UpdateStatus, Converter={StaticResource NotNullToVisible}}"
                     MouseLeftButtonUp="OnUpdateStatusClicked" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================== Toolbar ============================== -->
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="10,2,10,0" Padding="10,6">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <Button Content="Add robot" Command="{Binding AddRobotCommand}" />
          <Border Style="{StaticResource ToolbarSeparator}" />
          <Button Content="Probe" Command="{Binding ProbeSelectedCommand}"
                  ToolTip="Read-only check of the selected robot: what it is, and which ways in are open." />
          <Button Content="Back up" Style="{StaticResource PrimaryButton}" Command="{Binding BackupSelectedCommand}"
                  ToolTip="FTP copy of md: into the archive. RETR only - nothing is written to the robot." />
          <Button Content="Back up all" Command="{Binding BackupAllCommand}" />
          <Button Content="Stop" Command="{Binding StopCommand}" />
          <Border Style="{StaticResource ToolbarSeparator}" />
          <Button Content="Compare" Command="{Binding CompareCommand}" />
          <Button Content="Diagnose network" Command="{Binding DiagnoseNetworkCommand}"
                  ToolTip="Opens NetControl on this robot's address." />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Text="{Binding TargetText}" FontWeight="SemiBold" Margin="0,0,14,0" />
          <TextBlock Style="{StaticResource Muted}" Text="Read-only: RobControl never writes to a controller." />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Margin="10,8,10,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*" MinWidth="380" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="6*" MinWidth="420" />
      </Grid.ColumnDefinitions>

      <!-- ============================== Fleet ============================== -->
      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="4">
        <DataGrid ItemsSource="{Binding Robots}"
                  SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Extended"
                  SelectionChanged="OnRobotSelectionChanged"
                  ToolTip="Ctrl-click or Shift-click to select several robots: Probe, Back up and everything on the Trends tab act on all of them."
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  BorderThickness="0"
                  MouseDoubleClick="OnRobotDoubleClick">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="" Width="26">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:RobotRowViewModel}">
                  <Ellipse Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Fill="{Binding State, Converter={StaticResource ReadinessBrush}}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Robot" Width="110" Binding="{Binding Name, Mode=OneWay}" />
            <DataGridTextColumn Header="Address" Width="105" Binding="{Binding Address, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
            <DataGridTextColumn Header="Line" Width="80" Binding="{Binding Line, Mode=OneWay}" />
            <DataGridTextColumn Header="Last good backup" Width="150" Binding="{Binding LastGoodBackup, Mode=OneWay}" />
            <DataGridTemplateColumn Header="Activity" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:RobotRowViewModel}">
                  <Grid>
                    <ProgressBar Height="4" VerticalAlignment="Bottom" Minimum="0" Maximum="100"
                                 Value="{Binding Progress, Mode=OneWay}"
                                 Foreground="{DynamicResource accent}" Background="Transparent" BorderThickness="0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding Activity}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Activity}" />
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />

      <!-- ============================== Selected robot ============================== -->
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
        <TabControl x:Name="DetailTabs">

          <TabItem Header="Overview">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="14,12" DataContext="{Binding Selected}">
                <TextBlock Style="{StaticResource PanelTitle}" Text="{Binding Name}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,10">
                  <Run Text="{Binding Address, Mode=OneWay}" />
                  <Run Text="  " />
                  <Run Text="{Binding Line, Mode=OneWay}" />
                </TextBlock>

                <TextBlock Style="{StaticResource PanelHead}" Text="CONTROLLER" />
                <TextBlock Text="{Binding Controller}" TextWrapping="Wrap" Margin="0,2,0,10" />

                <TextBlock Style="{StaticResource PanelHead}" Text="BACKUPS" />
                <TextBlock Margin="0,2,0,0"><Run Text="Last: " /><Run Text="{Binding LastBackup, Mode=OneWay}" /></TextBlock>
                <TextBlock Margin="0,0,0,10"><Run Text="Last complete: " /><Run Text="{Binding LastGoodBackup, Mode=OneWay}" /></TextBlock>

                <TextBlock Style="{StaticResource PanelHead}" Text="LAST PROBE" />
                <TextBlock Text="{Binding ProbeSummary}" TextWrapping="Wrap" Margin="0,2,0,6" />
                <ItemsControl ItemsSource="{Binding ProbeSteps}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="10,6">
                        <StackPanel>
                          <TextBlock>
                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text=" - " />
                            <Run Text="{Binding Outcome, Mode=OneWay}" />
                          </TextBlock>
                          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Style="{StaticResource Muted}" />
                          <TextBlock Text="{Binding Remediation}" TextWrapping="Wrap" Style="{StaticResource MutedWarning}"
                                     Visibility="{Binding Remediation, Converter={StaticResource NotNullToVisible}}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Backups">
            <DockPanel Margin="8">
              <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="2,0,0,6" TextWrapping="Wrap"
                         Text="Tick two to compare them, or press Compare with none ticked for newest vs previous. Double-click opens the folder." />
              <DataGrid ItemsSource="{Binding Selected.Backups}"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        SelectionMode="Single"
                        HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal"
                        RowHeaderWidth="0"
                        BorderThickness="0"
                        MouseDoubleClick="OnBackupDoubleClick">
                <DataGrid.Columns>
                  <!-- A template column, not DataGridCheckBoxColumn: that one needs a click to enter edit
                       mode and a second to tick, which reads as a broken checkbox. -->
                  <DataGridTemplateColumn Header="" Width="30">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type vm:BackupRowViewModel}">
                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                  IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="" Width="22" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type vm:BackupRowViewModel}">
                        <Ellipse Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Fill="{Binding State, Converter={StaticResource ReadinessBrush}}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Taken" Width="125" IsReadOnly="True" Binding="{Binding When, Mode=OneWay}" />
                  <DataGridTextColumn Header="Outcome" Width="75" IsReadOnly="True" Binding="{Binding Outcome, Mode=OneWay}" />
                  <DataGridTextColumn Header="Files" Width="45" IsReadOnly="True" Binding="{Binding Files, Mode=OneWay}" />
                  <DataGridTextColumn Header="Size" Width="65" IsReadOnly="True" Binding="{Binding Size, Mode=OneWay}" />
                  <DataGridTextColumn Header="Summary" Width="*" IsReadOnly="True" Binding="{Binding Summary, Mode=OneWay}" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>

          <TabItem x:Name="ChangesTab" Header="Changes">
            <DockPanel Margin="8" DataContext="{Binding Compare}">
              <StackPanel DockPanel.Dock="Top" Margin="2,0,0,6">
                <TextBlock Style="{StaticResource PanelTitle}" Text="{Binding Title}" />
                <TextBlock Style="{StaticResource Muted}" Text="{Binding Summary}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <CheckBox Content="Hide unchanged" IsChecked="{Binding HideUnchanged}" Margin="0,0,14,0" />
                  <CheckBox Content="Hide live data (.DG)" IsChecked="{Binding HideLiveData}"
                            ToolTip=".DG files are snapshots of positions, clocks and counters, and differ between any two backups." />
                </StackPanel>
              </StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="230" MinWidth="160" />
                  <ColumnDefinition Width="6" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <DataGrid Grid.Column="0"
                          ItemsSource="{Binding Files}"
                          SelectedItem="{Binding SelectedFile}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          BorderThickness="0">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="File" Width="*" Binding="{Binding Path, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                    <DataGridTextColumn Header="Change" Width="65" Binding="{Binding Change, Mode=OneWay}" />
                    <DataGridTextColumn Header="" Width="55" Binding="{Binding Note, Mode=OneWay}" ElementStyle="{StaticResource Muted}" />
                  </DataGrid.Columns>
                </DataGrid>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />
                <ListBox Grid.Column="2"
                         ItemsSource="{Binding Lines}"
                         BorderThickness="0"
                         Background="{DynamicResource bg-0}"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="Padding" Value="0" />
                      <Setter Property="Margin" Value="0" />
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Row" Background="Transparent" Padding="4,0">
                              <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                              <DataTrigger Binding="{Binding Kind}" Value="added">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource row-good}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Kind}" Value="removed">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource row-bad}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Kind}" Value="header">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource bg-2}" />
                              </DataTrigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DiffLineViewModel}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource MonoText}" Width="44" TextAlignment="Right" Foreground="{DynamicResource txt-2}" Text="{Binding OldNumber}" />
                        <TextBlock Style="{StaticResource MonoText}" Width="44" TextAlignment="Right" Foreground="{DynamicResource txt-2}" Text="{Binding NewNumber}" />
                        <TextBlock Style="{StaticResource MonoText}" Width="18" TextAlignment="Center" Text="{Binding Marker}" />
                        <TextBlock Style="{StaticResource MonoText}" Text="{Binding Text}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </DockPanel>
          </TabItem>

          <TabItem x:Name="TrendsTab" Header="Trends">
            <DockPanel Margin="8" DataContext="{Binding Trend}">

              <!-- What is being acted on, and the controls. Everything here applies to every robot
                   selected in the list on the left. -->
              <StackPanel DockPanel.Dock="Top" Margin="2,0,0,6">
                <TextBlock Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis">
                  <Run Text="Acting on: " /><Run Text="{Binding Targets, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
                <DockPanel Margin="0,6,0,0">
                  <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddCommand}" Margin="6,0,0,0" />
                  <TextBox Text="{Binding AddText, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource mono}"
                           ToolTip="As on the pendant, comma separated, ranges allowed: R[1-10], DI[1..8], GI[1], $TIMER[1].$TIMER_VAL. Added to every selected robot." />
                </DockPanel>
                <WrapPanel Margin="0,6,0,0">
                  <Button Content="Read now" Command="{Binding ReadNowCommand}"
                          ToolTip="One read of every signal on every selected robot. Nothing is stored." />
                  <Border Style="{StaticResource ToolbarSeparator}" />
                  <TextBlock Text="Every" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <TextBox Width="44" Text="{Binding IntervalSeconds, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource mono}"
                           ToolTip="Seconds between polls, per robot. Never faster than 2 s." />
                  <TextBlock Text="s" VerticalAlignment="Center" Margin="4,0,8,0" />
                  <Button Content="Start recording" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}"
                          ToolTip="Records every selected robot at once, each on its own loop. Only changes are stored, plus one value a minute." />
                  <Button Content="Stop" Command="{Binding StopCommand}" ToolTip="Stops the selected robots." />
                  <Button Content="Stop all" Command="{Binding StopAllCommand}" />
                  <Border Style="{StaticResource ToolbarSeparator}" />
                  <Button Content="Remove signal" Command="{Binding RemoveCommand}" />
                  <Button Content="Export CSV" Command="{Binding ExportCommand}"
                          ToolTip="The plotted signals, in the window shown, one row per stored sample." />
                </WrapPanel>
                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="{Binding Status}" TextWrapping="Wrap" />
              </StackPanel>

              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="2*" MinHeight="90" />
                  <RowDefinition Height="6" />
                  <RowDefinition Height="3*" MinHeight="140" />
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding Rows}"
                          SelectedItem="{Binding SelectedSignal}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          BorderThickness="0"
                          VirtualizingPanel.IsVirtualizing="True">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Plot" Width="38">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:SignalRowViewModel}">
                          <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsChecked="{Binding IsPlotted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="22" IsReadOnly="True">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:SignalRowViewModel}">
                          <Ellipse Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Fill="{Binding State, Converter={StaticResource ReadinessBrush}}"
                                   ToolTip="{Binding Problem}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Robot" Width="90" IsReadOnly="True" Binding="{Binding RobotName, Mode=OneWay}" />
                    <DataGridTextColumn Header="Signal" Width="130" IsReadOnly="True" Binding="{Binding Address, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                    <DataGridTextColumn Header="Value" Width="90" IsReadOnly="True" Binding="{Binding Value, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                    <DataGridTextColumn Header="Read" Width="65" IsReadOnly="True" Binding="{Binding ReadAt, Mode=OneWay}" />
                    <DataGridTextColumn Header="From" Width="80" IsReadOnly="True" Binding="{Binding Source, Mode=OneWay}" ElementStyle="{StaticResource Muted}" />
                    <DataGridTemplateColumn Header="Problem" Width="*" IsReadOnly="True">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:SignalRowViewModel}">
                          <TextBlock Style="{StaticResource MutedWarning}" Text="{Binding Problem}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Problem}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" />

                <DockPanel Grid.Row="2">
                  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,2,0,4">
                    <TextBlock Text="Window" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Width="90" ItemsSource="{x:Static vm:TrendViewModel.Windows}" SelectedItem="{Binding Window}" />
                    <Button Content="Refresh" Command="{Binding RefreshChartCommand}" Margin="8,0,0,0" />
                  </StackPanel>
                  <Border BorderBrush="{DynamicResource line}" BorderThickness="1" CornerRadius="{DynamicResource corner-sm}" ClipToBounds="True">
                    <views:TrendChart Series="{Binding Series}" From="{Binding From}" To="{Binding To}" />
                  </Border>
                </DockPanel>
              </Grid>
            </DockPanel>
          </TabItem>

          <!-- ============ Fleet-wide tabs: read the archive, never a robot ============ -->

          <TabItem Header="Search">
            <DockPanel Margin="8" DataContext="{Binding Search}">
              <StackPanel DockPanel.Dock="Top">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Stop" Command="{Binding CancelCommand}" Margin="6,0,0,0" />
                  <Button DockPanel.Dock="Right" Content="Search" Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}" Margin="6,0,0,0" />
                  <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource mono}"
                           ToolTip="A program name (WELD_A), a register or port (R[45], PR[3], DO[120]) - found however the line writes it - or any text.">
                    <TextBox.InputBindings>
                      <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                  </TextBox>
                </DockPanel>
                <WrapPanel Margin="0,6,0,0">
                  <ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope}" Width="230" Margin="0,0,10,0" />
                  <CheckBox Content="Every backup, not just the newest" IsChecked="{Binding EveryBackup}" Margin="0,0,10,0" VerticalAlignment="Center"
                            ToolTip="Search the whole history - to find when a line first appeared or which backup still had it." />
                  <CheckBox Content="Match case" IsChecked="{Binding CaseSensitive}" Margin="0,0,10,0" VerticalAlignment="Center" />
                  <CheckBox Content="Regex" IsChecked="{Binding IsRegex}" Margin="0,0,10,0" VerticalAlignment="Center" />
                  <Button Content="Programs nothing calls" Command="{Binding NotCalledCommand}"
                          ToolTip="Programs no other program CALLs or RUNs, per robot. They may still be started by PNS, RSR, a style table, a macro or the PLC." />
                </WrapPanel>
                <TextBlock Style="{StaticResource Muted}" Text="{Binding Status}" TextWrapping="Wrap" Margin="2,6,0,6" />
              </StackPanel>

              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="2*" MinHeight="80" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" MinHeight="60" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" MinHeight="60" />
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0" ItemsSource="{Binding Hits}" SelectedItem="{Binding SelectedHit}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" RowHeaderWidth="0" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Robot" Width="110" Binding="{Binding Robot, Mode=OneWay}" />
                    <DataGridTextColumn Header="Program" Width="110" Binding="{Binding Program, Mode=OneWay}" />
                    <DataGridTextColumn Header="Line" Width="50" Binding="{Binding Line, Mode=OneWay}" />
                    <DataGridTextColumn Header="Text" Width="*" Binding="{Binding Text, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                    <DataGridTextColumn Header="File" Width="120" Binding="{Binding File, Mode=OneWay}" />
                    <DataGridTextColumn Header="Backup" Width="130" Binding="{Binding Stamp, Mode=OneWay}" />
                  </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="Transparent" />

                <TextBox Grid.Row="2" Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" FontFamily="{DynamicResource mono}"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                         ToolTip="The lines around the selected hit, from the backup on disk." />

                <TextBlock Grid.Row="3" Style="{StaticResource PanelHead}" Text="{Binding UsesTitle}" TextWrapping="Wrap" Margin="2,8,0,4" />

                <DataGrid Grid.Row="4" ItemsSource="{Binding Uses}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" RowHeaderWidth="0" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Robot" Width="110" Binding="{Binding Robot, Mode=OneWay}" />
                    <DataGridTextColumn Header="Program" Width="130" Binding="{Binding Program, Mode=OneWay}" />
                    <DataGridTextColumn Header="Comment" Width="*" Binding="{Binding Comment, Mode=OneWay}" />
                    <DataGridTextColumn Header="Lines" Width="120" Binding="{Binding LineList, Mode=OneWay}" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </DockPanel>
          </TabItem>

          <TabItem Header="Alarms">
            <DockPanel Margin="8" DataContext="{Binding Alarms}">
              <StackPanel DockPanel.Dock="Top">
                <WrapPanel>
                  <Button Content="Refresh" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,10,0"
                          ToolTip="Reads the alarm log (ERRALL.LS) in every backup of this site and merges them - a longer history than the controller keeps." />
                  <TextBlock Text="Period" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}" Width="100" Margin="0,0,10,0" />
                  <CheckBox Content="Only battery, collision and mastering" IsChecked="{Binding OnlyConcerns}" VerticalAlignment="Center" />
                </WrapPanel>
                <TextBlock Style="{StaticResource Muted}" Text="{Binding Status}" TextWrapping="Wrap" Margin="2,6,0,6" />
              </StackPanel>

              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" MinHeight="80" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" MinHeight="80" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DataGrid Grid.Row="0" Grid.ColumnSpan="3" ItemsSource="{Binding Codes}" SelectedItem="{Binding SelectedCode}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" RowHeaderWidth="0" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Alarm" Width="85" Binding="{Binding Code, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                    <DataGridTextColumn Header="Message" Width="*" Binding="{Binding Message, Mode=OneWay}" />
                    <DataGridTextColumn Header="Count" Width="55" Binding="{Binding Count, Mode=OneWay}" />
                    <DataGridTextColumn Header="Robots" Width="150" Binding="{Binding Robots, Mode=OneWay}" />
                    <DataGridTextColumn Header="Last seen" Width="120" Binding="{Binding LastSeen, Mode=OneWay, StringFormat=g}" />
                    <DataGridTextColumn Header="Needs a job" Width="85" Binding="{Binding ConcernText, Mode=OneWay}" />
                  </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource PanelHead}" Text="PER ROBOT" Margin="2,10,0,4" />
                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource PanelHead}" Text="OCCURRENCES OF THE SELECTED ALARM" Margin="2,10,0,4" />

                <DataGrid Grid.Row="2" Grid.Column="0" ItemsSource="{Binding Robots}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" RowHeaderWidth="0" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Robot" Width="*" Binding="{Binding Robot, Mode=OneWay}" />
                    <DataGridTextColumn Header="Alarms" Width="55" Binding="{Binding Count, Mode=OneWay}" />
                    <DataGridTextColumn Header="Most frequent" Width="95" Binding="{Binding TopCode, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                    <DataGridTextColumn Header="Mean time between" Width="115" Binding="{Binding MeanTimeBetweenText, Mode=OneWay}" />
                  </DataGrid.Columns>
                </DataGrid>

                <DataGrid Grid.Row="2" Grid.Column="2" ItemsSource="{Binding Occurrences}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" RowHeaderWidth="0" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="When" Width="125" Binding="{Binding When, Mode=OneWay, StringFormat=g}" />
                    <DataGridTextColumn Header="Robot" Width="*" Binding="{Binding Robot, Mode=OneWay}" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </DockPanel>
          </TabItem>

          <TabItem Header="Fleet">
            <DockPanel Margin="8" DataContext="{Binding Fleet}">
              <StackPanel DockPanel.Dock="Top">
                <WrapPanel>
                  <Button Content="Refresh" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,6,0" />
                  <Button Content="Export CSV..." Command="{Binding ExportCsvCommand}" Margin="0,0,6,0" />
                  <Button Content="Site report..." Command="{Binding ReportCommand}" Margin="0,0,10,0"
                          ToolTip="One page for the visit: backup status, alarms needing a job, frequent alarms, watched setting changes and site notes. Opens in the browser to print or save as PDF." />
                  <TextBlock Text="Changes in the last" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}" Width="100" />
                </WrapPanel>
                <TextBlock Style="{StaticResource Muted}" Text="{Binding Status}" TextWrapping="Wrap" Margin="2,6,0,6" />
              </StackPanel>

              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" MinHeight="80" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" MinHeight="80" />
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0" ItemsSource="{Binding Rows}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" RowHeaderWidth="0" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Robot" Width="100" Binding="{Binding Robot, Mode=OneWay}" />
                    <DataGridTextColumn Header="Address" Width="95" Binding="{Binding Address, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                    <DataGridTextColumn Header="Line" Width="70" Binding="{Binding Line, Mode=OneWay}" />
                    <DataGridTextColumn Header="Controller" Width="90" Binding="{Binding Controller, Mode=OneWay}" />
                    <DataGridTextColumn Header="Model" Width="110" Binding="{Binding Model, Mode=OneWay}" />
                    <DataGridTextColumn Header="Software" Width="*" Binding="{Binding Software, Mode=OneWay}" />
                    <DataGridTextColumn Header="F-number" Width="75" Binding="{Binding FNumber, Mode=OneWay}" />
                    <DataGridTextColumn Header="Last complete" Width="115" Binding="{Binding LastComplete, Mode=OneWay}" />
                    <DataGridTextColumn Header="Age" Width="65" Binding="{Binding Age, Mode=OneWay}">
                      <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStale}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource bad}" />
                              <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Last attempt" Width="80" Binding="{Binding LastOutcome, Mode=OneWay}" />
                  </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="1" Style="{StaticResource PanelHead}" Margin="2,10,0,4"
                           Text="WATCHED SETTING CHANGES - FRAMES, PAYLOAD, MASTERING, REFERENCE POSITIONS, JOINT LIMITS, DCS, SOFTWARE VERSION" TextWrapping="Wrap" />

                <DataGrid Grid.Row="2" ItemsSource="{Binding Changes}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" RowHeaderWidth="0" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Backup" Width="125" Binding="{Binding NewerStamp, Mode=OneWay}" />
                    <DataGridTextColumn Header="Robot" Width="90" Binding="{Binding Robot, Mode=OneWay}" />
                    <DataGridTextColumn Header="What" Width="105" Binding="{Binding Category, Mode=OneWay}" />
                    <DataGridTextColumn Header="Variable" Width="120" Binding="{Binding Variable, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                    <DataGridTextColumn Header="Before" Width="*" Binding="{Binding OldText, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                    <DataGridTextColumn Header="After" Width="*" Binding="{Binding NewText, Mode=OneWay}" ElementStyle="{StaticResource MonoText}" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </DockPanel>
          </TabItem>

          <TabItem Header="Event log">
            <DockPanel Margin="8">
              <CheckBox DockPanel.Dock="Top" Margin="2,0,0,6" Content="Only the selected robot" IsChecked="{Binding EventsForSelectedOnly}" />
              <DataGrid ItemsSource="{Binding Events}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        SelectionMode="Single"
                        HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal"
                        RowHeaderWidth="0"
                        BorderThickness="0"
                        VirtualizingPanel.IsVirtualizing="True">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="" Width="22">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type vm:EventRowViewModel}">
                        <Ellipse Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Fill="{Binding State, Converter={StaticResource ReadinessBrush}}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="When" Width="135" Binding="{Binding When, Mode=OneWay}" />
                  <DataGridTextColumn Header="What" Width="60" Binding="{Binding Category, Mode=OneWay}" />
                  <DataGridTextColumn Header="Robot" Width="150" Binding="{Binding Robot, Mode=OneWay}" />
                  <DataGridTemplateColumn Header="Message" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type vm:EventRowViewModel}">
                        <TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>

        </TabControl>
      </Border>
    </Grid>

  </DockPanel>
</Window>
