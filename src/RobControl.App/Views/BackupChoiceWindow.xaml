<Window x:Class="RobControl.App.Views.BackupChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RobControl.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:BackupChoiceViewModel}"
        Title="Back up"
        SizeToContent="Height"
        Width="600"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource ChromeDialog}">

  <StackPanel Margin="18,12,18,14">
    <TextBlock Style="{StaticResource PanelTitle}" Text="{Binding Heading}" />
    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,10"
               Text="Which devices to copy this time. Ticked from the system's and robot's backup settings; nothing here is saved. RETR only - nothing is written to the robot." />

    <CheckBox Content="Use each robot's own backup settings (they differ)" Margin="0,0,0,8"
              IsChecked="{Binding UseEachRobotsOwn}"
              Visibility="{Binding RobotsDiffer, Converter={StaticResource BoolToVisible}}" />

    <StackPanel IsEnabled="{Binding CanChoose}">
      <TextBlock Style="{StaticResource PanelHead}" Text="DEVICES" Margin="0,0,0,4" />
      <ItemsControl ItemsSource="{Binding Devices}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:DeviceChoice}">
            <Grid Margin="0,3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" VerticalAlignment="Top">
                <TextBlock Text="{Binding Device}" FontFamily="{DynamicResource mono}" FontWeight="SemiBold" />
              </CheckBox>
              <TextBlock Grid.Column="1" Text="{Binding Description}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <DockPanel Margin="0,6,0,0">
        <TextBlock Text="Other" Width="80" VerticalAlignment="Center" />
        <TextBox Text="{Binding OtherDevices, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource mono}"
                 ToolTip="Any other device, comma separated: FRH:, MC2:. A device the controller does not have fails on its own; the rest still arrive." />
      </DockPanel>

      <CheckBox Content="Also copy the folders inside each device (FR: and FRA: have them)" Margin="0,10,0,0"
                IsChecked="{Binding IncludeSubfolders}"
                ToolTip="Up to four levels down. Off: a folder is noted in the backup's manifest and skipped - the backup is still complete." />
    </StackPanel>

    <TextBlock Style="{StaticResource MutedWarning}" TextWrapping="Wrap" Margin="0,10,0,0"
               Text="A memory card or USB stick that is not in fails that device only, and the backup shows as Partial." />

    <TextBlock Style="{StaticResource FaultText}" TextWrapping="Wrap" Margin="0,8,0,0"
               Text="{Binding Problem}" Visibility="{Binding Problem, Converter={StaticResource NotNullToVisible}}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Back up" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk" MinWidth="90" />
      <Button Content="Cancel" IsCancel="True" MinWidth="80" Margin="8,0,0,0" />
    </StackPanel>
  </StackPanel>
</Window>
