<Window x:Class="RobControl.App.Views.SystemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System settings"
        SizeToContent="Height"
        Width="560"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource ChromeDialog}">

  <Grid Margin="18,16,18,14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="130" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Name" VerticalAlignment="Center" />
    <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Margin="0,3"
             ToolTip="The line, the cell, the job number. Shown in the title bar beside the site." />

    <TextBlock Grid.Row="1" Text="Notes" VerticalAlignment="Top" Margin="0,6,0,0" />
    <TextBox Grid.Row="1" Grid.Column="1" x:Name="NotesBox" Margin="0,3" Height="52"
             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource PanelHead}" Text="BACKUP SETTINGS FOR THIS SYSTEM" Margin="0,12,0,2" />
    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"
               Text="What Back up starts with for every robot here, and what a scheduled backup takes. A robot can override any of these in its own dialog." />

    <TextBlock Grid.Row="4" Text="Devices" VerticalAlignment="Center" />
    <TextBox Grid.Row="4" Grid.Column="1" x:Name="DevicesBox" Margin="0,3" FontFamily="{DynamicResource mono}"
             ToolTip="Comma separated: MD:, FR:, FRA:, MC:, UD1:. Blank is MD: only." />

    <TextBlock Grid.Row="5" Text="Folders" VerticalAlignment="Center" />
    <CheckBox Grid.Row="5" Grid.Column="1" x:Name="SubfoldersBox" Margin="0,5" Content="Copy the folders inside each device"
              ToolTip="FR: and FRA: have folders; MD: does not. Up to four levels down." />

    <TextBlock Grid.Row="6" Text="Leave out" VerticalAlignment="Top" Margin="0,6,0,0" />
    <TextBox Grid.Row="6" Grid.Column="1" x:Name="ExcludeBox" Margin="0,3" Height="52" FontFamily="{DynamicResource mono}"
             AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
             ToolTip="One pattern per line. * and ? only: *.DG leaves out every .DG file, LOGBOOK/* everything in that folder. Left-out files are listed in the backup's manifest." />

    <TextBlock Grid.Row="7" Text="Gentler" VerticalAlignment="Center" />
    <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
      <TextBox x:Name="PauseBox" Width="60" FontFamily="{DynamicResource mono}"
               ToolTip="Milliseconds between files, for a controller that struggles. Blank is none." />
      <TextBlock Text="ms between files" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,16,0" />
      <TextBox x:Name="AttemptsBox" Width="40" FontFamily="{DynamicResource mono}"
               ToolTip="Tries per file before it is recorded as a failure, 1 to 5. Blank is 2." />
      <TextBlock Text="tries per file" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0" />
    </StackPanel>

    <TextBlock Grid.Row="8" Grid.ColumnSpan="2" x:Name="PathText" Style="{StaticResource Muted}" TextWrapping="Wrap"
               FontFamily="{DynamicResource mono}" Margin="0,10,0,0" />

    <TextBlock Grid.Row="9" Grid.ColumnSpan="2" x:Name="ProblemText" Style="{StaticResource FaultText}"
               TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />

    <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="OK" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk" MinWidth="80" />
      <Button Content="Cancel" IsCancel="True" MinWidth="80" Margin="8,0,0,0" />
    </StackPanel>
  </Grid>
</Window>
